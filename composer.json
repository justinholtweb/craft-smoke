{
    "name": "justinholtweb/craft-smoke",
    "description": "On-page frontend editing for Craft CMS using DataStar",
    "type": "craft-plugin",
    "version": "5.0.0",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "smoke",
        "frontend-editing",
        "datastar"
    ],
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "craftcms/cms": "^5.4.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\smoke\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/justinholtweb/craft-smoke/issues",
        "source": "https://github.com/justinholtweb/craft-smoke"
    },
    "extra": {
        "name": "Smoke",
        "handle": "smoke",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://github.com/justinholtweb/craft-smoke",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-smoke/main/CHANGELOG.md",
        "class": "justinholtweb\\smoke\\Plugin"
    }
}
