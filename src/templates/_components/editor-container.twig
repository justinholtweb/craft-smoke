{# Smoke Editor Container — injected automatically by craft.smoke.init() #}

{# Slide-out panel host. The panel HTML is morphed into #smoke-editor via DataStar SSE.
   $smokeEditorOpen drives the slide-in (see #smoke-editor[data-smoke-open="true"] in smoke.css). #}
<div
    id="smoke-editor"
    data-signals="{smokeEditorOpen: false, smokeElementId: null, smokeSaving: false, smokeSuccess: '', smokeError: '', smokeSavedFields: null}"
    data-attr:data-smoke-open="$smokeEditorOpen ? 'true' : 'false'"
></div>

{# When the panel saves, the server patches `smokeSavedFields`; apply those values to the
   on-page display elements (live refresh). on-signal-patch fires whenever signals change. #}
<div data-on-signal-patch="window.smokeApplySavedFields($smokeSavedFields)" hidden></div>

{# Floating "Edit Page" button. Rendered server-side so DataStar binds it during its initial
   scan (avoids a first-click race). The element id is resolved from the page at click time.
   smoke.js reveals it only when the page actually has editable fields. #}
<div id="smoke-edit-button-container">
    <button
        class="smoke-edit-btn"
        data-on:click="@get('/actions/smoke/edit/open?elementId=' + (document.querySelector('[data-smoke-editable]')?.getAttribute('data-smoke-element-id') || ''))"
        hidden
    >Edit Page</button>
</div>

{# Feedback toasts, driven by signals the server patches in. Auto-clear after a few seconds. #}
<div
    class="smoke-notification smoke-notification-success"
    data-show="$smokeSuccess !== ''"
    data-text="$smokeSuccess"
    data-effect="$smokeSuccess !== '' && setTimeout(() => $smokeSuccess = '', 3000)"
></div>
<div
    class="smoke-notification smoke-notification-error"
    data-show="$smokeError !== ''"
    data-text="$smokeError"
    data-effect="$smokeError !== '' && setTimeout(() => $smokeError = '', 4000)"
></div>
