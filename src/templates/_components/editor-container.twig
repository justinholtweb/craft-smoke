{# Smoke Editor Container - Injected automatically by smoke.init() #}

{# Edit Panel Container #}
<div
    id="smoke-editor"
    data-smoke-open="false"
    data-store="{smokeEditorOpen: false}"
>
    {# Content will be dynamically loaded here #}
</div>

{# Floating Edit Button - Auto-shows when editable fields are present #}
<div id="smoke-edit-button-container"></div>

<script>
(function() {
    // Wait for both DOM and DataStar to be ready
    function initEditButton() {
        // Look for elements with smoke editable attributes
        const editableElements = document.querySelectorAll('[data-smoke-editable]');
        if (editableElements.length > 0) {
            // Get the element ID from the first editable element
            const firstEditable = editableElements[0];
            const elementId = firstEditable.getAttribute('data-smoke-element-id');

            if (elementId) {
                // Create the edit button container with DataStar binding
                const container = document.getElementById('smoke-edit-button-container');

                // Create button with inline onclick instead of DataStar attribute
                const button = document.createElement('button');
                button.className = 'smoke-edit-btn';
                button.textContent = 'Edit Page';
                button.onclick = function() {
                    // Manually fetch and open the editor
                    fetch('/actions/smoke/edit/open?elementId=' + elementId, {
                        headers: {
                            'Accept': 'text/event-stream',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(response => response.text())
                    .then(data => {
                        // Parse SSE response and update DOM
                        const events = data.split('\n\n').filter(e => e.trim());
                        events.forEach(event => {
                            if (event.includes('event: datastar-fragment')) {
                                const dataLine = event.split('\n').find(line => line.startsWith('data: '));
                                if (dataLine) {
                                    const fragmentData = JSON.parse(dataLine.substring(6));
                                    const target = document.querySelector(fragmentData.selector);
                                    if (target) {
                                        target.innerHTML = fragmentData.html;
                                        target.setAttribute('data-smoke-open', 'true');
                                    }
                                }
                            }
                        });
                    });
                };

                container.appendChild(button);
            }
        }
    }

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initEditButton);
    } else {
        initEditButton();
    }
})();
</script>
