{# Matrix Field Editor #}

<div class="smoke-field-group">
    <label class="smoke-field-label">
        {{ field.name }}
        {% if field.required %}
            <span class="smoke-field-required">*</span>
        {% endif %}
    </label>

    {% if field.instructions %}
        <span class="smoke-field-instructions">{{ field.instructions }}</span>
    {% endif %}

    {% set blocks = value.all() %}

    <div style="padding: 12px; background: #f3f4f6; border-radius: 6px;">
        {% if blocks|length %}
            <p style="margin: 0; color: #374151;">
                {{ blocks|length }} block(s) in this field
            </p>
            <ul style="list-style: none; padding: 0; margin: 8px 0 0 0;">
                {% for block in blocks %}
                    <li style="padding: 6px 0; color: #6b7280;">
                        {{ block.type.name }}
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p style="margin: 0; color: #6b7280;">No blocks</p>
        {% endif %}
    </div>

    <p style="font-size: 12px; color: #6b7280; margin-top: 12px;">
        Matrix field editing coming soon. For now, use the Control Panel to manage Matrix blocks.
    </p>
</div>
