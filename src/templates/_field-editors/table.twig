{# Table Field Editor.

   The cells are plain inputs; smoke.js serializes the whole table into a hidden,
   DataStar-bound textarea as JSON on every change. SmokeService::prepareValueForSave()
   decodes that JSON back into a rows array for setFieldValue(). #}

{% set rows = value ?? [] %}

<div class="smoke-field-group">
    <label class="smoke-field-label">
        {{ field.name }}
        {% if field.required %}<span class="smoke-field-required">*</span>{% endif %}
    </label>

    {% if field.instructions %}
        <span class="smoke-field-instructions">{{ field.instructions }}</span>
    {% endif %}

    <div class="smoke-table-wrap" data-smoke-table style="overflow-x: auto;">
        <table class="smoke-table">
            <thead>
                <tr>
                    {% for colId, column in field.columns %}
                        <th>{{ column.heading ?: (column.handle ?: colId) }}</th>
                    {% endfor %}
                    <th style="width: 40px;"></th>
                </tr>
            </thead>
            <tbody>
                {% for row in (rows|length ? rows : [{}]) %}
                    <tr>
                        {% for colId, column in field.columns %}
                            {% set key = column.handle ?: colId %}
                            <td>
                                <input type="text" class="smoke-input" data-col="{{ key }}" value="{{ row[key] ?? '' }}">
                            </td>
                        {% endfor %}
                        <td>
                            <button type="button" class="smoke-table-remove" aria-label="Remove row">×</button>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <button type="button" class="smoke-table-add" style="margin-top: 12px;">+ Add Row</button>

        {# Hidden, DataStar-bound JSON mirror of the table rows #}
        <textarea class="smoke-table-input" data-bind="fields.{{ fieldHandle }}" hidden></textarea>
    </div>
</div>
