{# Plain Text Field Editor #}

<div class="smoke-field-group">
    <label class="smoke-field-label">
        {{ field.name }}
        {% if field.required %}
            <span class="smoke-field-required">*</span>
        {% endif %}
    </label>

    {% if field.instructions %}
        <span class="smoke-field-instructions">{{ field.instructions }}</span>
    {% endif %}

    <input
        type="text"
        class="smoke-input"
        name="{{ fieldHandle }}"
        value="{{ value }}"
        {% if field.required %}required{% endif %}
        data-model="fields.{{ fieldHandle }}"
    >
</div>
