{# Assets Field Editor #}

<div class="smoke-field-group">
    <label class="smoke-field-label">
        {{ field.name }}
        {% if field.required %}
            <span class="smoke-field-required">*</span>
        {% endif %}
    </label>

    {% if field.instructions %}
        <span class="smoke-field-instructions">{{ field.instructions }}</span>
    {% endif %}

    {% set currentAssets = value.all() %}

    <div class="smoke-asset-grid">
        {% for asset in currentAssets %}
            <div class="smoke-asset-item">
                {% if asset.kind == 'image' %}
                    <img src="{{ asset.url }}" alt="{{ asset.title }}">
                {% else %}
                    <div style="padding: 12px; text-align: center;">
                        {{ asset.title }}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    <input
        type="hidden"
        name="{{ fieldHandle }}"
        value="{{ currentAssets|map(a => a.id)|join(',') }}"
        data-bind="fields.{{ fieldHandle }}"
    >

    <p style="font-size: 12px; color: #6b7280; margin-top: 12px;">
        Asset selection UI coming soon. For now, use the Control Panel to manage assets.
    </p>
</div>
